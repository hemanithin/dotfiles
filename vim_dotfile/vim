" Basic UI
set nu                 " Show line numbers
"set relativenumber     " Show relative line numbers
"set showcmd            " Show command in bottom bar
set showmode           " Show current mode
set ruler              " Show cursor position

" Searching
set ignorecase         " Case-insensitive search
set smartcase          " Smart case: case-sensitive if caps used
set hlsearch           " Highlight search results
set incsearch          " Show search results while typing

" Indentation
set autoindent         " Auto-indent new lines
set smartindent        " Smarter indenting
set tabstop=4          " 4 spaces = tab
set shiftwidth=4       " Shift 4 spaces when auto-indenting
set expandtab          " Use spaces instead of tabs

" Appearance
syntax on              " Enable syntax highlighting
"set background=light    " Use dark background theme (change to 'light' if needed)
"set cursorline         " Highlight current line

" Mouse
"set mouse=a            " Enable mouse in all modes

" File Handling
" set backup             " Enable backup files
set undofile           " Persistent undo
set hidden             " Allow buffers without saving
"set nobackup           " Don't keep backup file (~)
"set nowritebackup      " Don't make a second backup before writing

" Clipboard

" Performance
set lazyredraw         " Faster scrolling
set timeoutlen=500     " Shorter command timeout

" Status line
set laststatus=2       " Always show status line
set cmdheight=2        " More space for messages

" Split handling
set splitbelow         " Horizontal split below
set splitright         " Vertical split to the right
