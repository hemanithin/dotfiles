# List files in table view
function ll {
    Get-ChildItem | Format-Table Name, Length, LastWriteTime
}

# List files sorted by time with human-readable size
function lk {
    Get-ChildItem | Sort-Object LastWriteTime | Select-Object Name,
    @{ Name = 'Size'; Expression = {
        $size = $_.Length
        if ($size -ge 1GB) { "{0:N1}G" -f ($size / 1GB) }
        elseif ($size -ge 1MB) { "{0:N1}M" -f ($size / 1MB) }
        elseif ($size -ge 1KB) { "{0:N1}K" -f ($size / 1KB) }
        else { "$size B" }
    }},
    LastWriteTime | Format-Table -AutoSize
}

